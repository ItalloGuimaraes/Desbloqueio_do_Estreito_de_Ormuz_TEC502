# IP visível externamente desta máquina (usado por sensores/drones para alcançar brokers)
IP_MAQUINA=172.31.160.1

# SEED_ADDR: como broker2 e broker3 alcançam broker1 de dentro do Docker Desktop (Windows/Mac)
# host.docker.internal resolve para o gateway do host no Docker Desktop
SEED_ADDR=host.docker.internal:9000

# Endereços externos dos brokers (IP real da máquina + porta mapeada no host)
ADDR_BROKER_1=172.31.160.1:9000
ADDR_BROKER_2=172.31.160.1:9001
ADDR_BROKER_3=172.31.160.1:9002