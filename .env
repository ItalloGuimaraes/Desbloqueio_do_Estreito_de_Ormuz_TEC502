# IP visível externamente desta máquina (usado por sensores/drones para alcançar brokers)
IP_MAQUINA=172.16.201.11

# SEED_ADDR: como broker2 e broker3 alcançam broker1 de dentro do Docker Desktop
SEED_ADDRS=172.16.201.11:9000

# Endereços externos dos brokers (IP real da máquina + porta mapeada no host)
ADDR_BROKER_1=172.16.201.11:9000
ADDR_BROKER_2=172.16.201.11:9000
ADDR_BROKER_3=172.16.201.11:9000




